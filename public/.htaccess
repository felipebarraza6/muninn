# Patagon.IA — Apache config para SPA React en clinica.agenciapatagoniachile.com
# Copiar este archivo junto con el contenido de dist/ al directorio raíz del sitio.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forzar HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Redirigir www a non-www (opcional, descomentar si se prefiere)
    # RewriteCond %{HTTP_HOST} ^www\. [NC]
    # RewriteRule ^(.*)$ https://clinica.agenciapatagoniachile.com/$1 [R=301,L]

    # Si el archivo o directorio solicitado no existe, servir index.html (SPA)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [QSA,L]
</IfModule>

<IfModule mod_deflate.c>
    # Compresión para assets estáticos
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/rss+xml application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE application/x-font-ttf font/opentype image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On

    # HTML sin cache (SPA)
    ExpiresByType text/html "access plus 0 seconds"

    # Assets con hash inmutable: cache largo
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # No cachear index.html (la SPA decide cuando actualizar assets hasheados)
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Cache agresiva para assets hasheados de Vite (/assets/)
    <FilesMatch "^/assets/.*-[a-zA-Z0-9]+\.(js|css|png|jpg|jpeg|svg|gif|webp|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Seguridad básica
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # HTTPS forzado (HSTS) — activar solo cuando todo funcione con SSL
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# CORS para fuentes y assets estáticos (necesario si algún día sirves fuentes cross-origin)
<IfModule mod_headers.c>
    <FilesMatch "\.(ttf|otf|eot|woff|woff2|css|js|png|jpg|jpeg|svg|gif|webp)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>
