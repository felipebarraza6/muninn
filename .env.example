# URL de la API en builds de preview/producción (obligatoria; se inyecta en CD por dominio).
# Sin esta variable el build de production falla (no hay fallback a un tenant).
# En desarrollo la app usa /api vía proxy de Vite; no hace falta esta variable.
VITE_API_URL=https://api.yggdra.cl/api

# Entorno de la app en el bundle. `staging` muestra un indicador visible.
# En CD de GitHub Pages se inyecta VITE_APP_ENV=staging; en producción queda production.
# VITE_APP_ENV=staging

# Base URL del widget embebido (opcional).
# VITE_WIDGET_BASE_URL=https://agents.example.com

# Hub WebSocket de realtime (opcional). Vacío = solo polling.
# VITE_REALTIME_URL=wss://api.example.com/ws/studio/

# Solo desarrollo: target del proxy Vite para /api (default: http://localhost:8000).
# VITE_DEV_API_PROXY=http://localhost:8000

# Sesión. `token` (default): Authorization Token en localStorage (hasta activar cookie).
# `cookie`: cookie HttpOnly + header X-CSRFToken. Actívalo cuando el backend ya
# despliegue la cookie; entonces se deja de persistir el token en disco.
# VITE_AUTH_MODE=token

# Facturación y registro. Vacío = API real. `mock` muestra cifras de ejemplo
# marcadas en pantalla y no abre Flow. No lo actives en un build público.
# VITE_COMMERCIAL_API=live

# Solo desarrollo: plantillas de ejemplo del catálogo si el API aún no responde.
# Nunca en staging/producción.
# VITE_AGENT_CATALOG_MOCK=1

# Hosts extra que son Muninn y no deben tomar la marca de by-host.
# muninn.yggdra.cl, felipebarraza6.github.io, localhost y 127.0.0.1 ya van fijos.
# VITE_MUNINN_HOSTS=preview.ejemplo.cl

# PWA (opcional por dominio en build).
# VITE_PWA_NAME=Muninn
# VITE_PWA_THEME_COLOR=#0b1210
