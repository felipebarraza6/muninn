# URL de la API en builds de preview/producción (obligatoria; se inyecta en CD por dominio).
# Sin esta variable el build de production falla (no hay fallback a un tenant).
# En desarrollo la app usa /api vía proxy de Vite; no hace falta esta variable.
VITE_API_URL=https://api.example.com/api

# Base URL del widget embebido (opcional).
# VITE_WIDGET_BASE_URL=https://agents.example.com

# Hub WebSocket de realtime (opcional). Vacío = solo polling.
# VITE_REALTIME_URL=wss://api.example.com/ws/studio/

# Solo desarrollo: target del proxy Vite para /api (default: http://localhost:8000).
# VITE_DEV_API_PROXY=http://localhost:8000

# PWA (opcional por dominio en build).
# VITE_PWA_NAME=Muninn
# VITE_PWA_THEME_COLOR=#0b1210
